\newlabel{fig:combined}{{2}{4}{(a)~Wall-clock time by chromosome for the three tools across 10 replicate runs. (b)~Speedup factor of pMMC relative to cudaMMC and 3D-GNOME, shown per chromosome. Error bars indicate standard deviation across 10 runs}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (a)~Scaling regression of wall-clock time vs.\ number of segments for the primary benchmark. (b)~Scalability comparison across all human autosomes and chromosome~X on GRCh38 data (3 runs per chromosome). pMMC (blue) maintains near-constant wall-clock time regardless of chromosome size, whereas cudaMMC (red) exhibits size-dependent scaling.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:scaling}{{3}{4}{(a)~Scaling regression of wall-clock time vs.\ number of segments for the primary benchmark. (b)~Scalability comparison across all human autosomes and chromosome~X on GRCh38 data (3 runs per chromosome). pMMC (blue) maintains near-constant wall-clock time regardless of chromosome size, whereas cudaMMC (red) exhibits size-dependent scaling}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces (a)~Output quality heatmap: Pearson correlation of pairwise distance matrices between tools and across chromosomes. (b)~Phase breakdown showing time distribution across Monte Carlo phases for each tool, illustrating how pMMC shifts the computational burden from CPU to GPU.}}{4}{figure.caption.8}\protected@file@percent }
